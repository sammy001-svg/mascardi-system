# Copy this file to .env and fill in your values
# NEVER commit .env to version control

DB_HOST=localhost
DB_NAME=mascardi_db
DB_USER=root
DB_PASS=

APP_ENV=production
APP_DEBUG=false
APP_NAME="Mascardi Luxury Cars"

# Carl AI — optional. When set, Carl uses Claude for natural-language intent
# routing, conversational answers, and varied daily greetings. She works fully
# offline without it. Stored in the settings table via the Settings > Carl AI tab.
